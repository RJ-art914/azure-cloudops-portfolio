{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "python",
    "APP_STORAGE_ACCOUNT_NAME": "REPLACE_WITH_TERRAFORM_OUTPUT",
    "INCIDENTS_TABLE_NAME": "incidents",
    "ATTACHMENTS_CONTAINER_NAME": "incident-attachments",
    "CORS_ALLOWED_ORIGIN": "http://127.0.0.1:5500",
    "RATE_LIMITS_TABLE_NAME": "ratelimits",
    "WRITE_LIMIT_PER_HOUR": "30",
    "MAX_REQUEST_BYTES": "8192",
    "MAX_TITLE_LENGTH": "100",
    "MAX_SERVICE_LENGTH": "80",
    "MAX_DESCRIPTION_LENGTH": "1000"
  }
}
